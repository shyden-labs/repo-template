{
  "name": "repo-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts/dev-pass",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}

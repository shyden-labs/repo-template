#!/usr/bin/env bash
# The static checks before every push (issue #61): format, lint and typecheck.
# They need no test lock and fail in seconds. No test suite runs here (global
# rule 2026-10-12): run the unit suite by hand before each push; every suite
# runs in CI on the pull request.
# `npm install` installs this hook: the `prepare` script points git's
# core.hooksPath at .githooks.
set -euo pipefail

npm run --silent format:check
npm run --silent lint
npm run --silent typecheck
